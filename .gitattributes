* text=auto
/.gitattributes text eol=lf
/.gitignore text eol=lf
/.editorconfig text eol=lf
*.md text eol=lf
*.cs text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.ini text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf
*.json text eol=lf

*.uasset filter=lfs diff=lfs merge=lfs -text
